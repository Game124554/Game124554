package net.latexdrones.registry;

import java.util.ArrayList;
import java.util.List;

import net.latexdrones.LatexDrones;
import net.latexdrones.block.AlarmBlock;
import net.latexdrones.block.ChamberBlock;
import net.latexdrones.block.ChargingPadBlock;
import net.latexdrones.block.DeconBlock;
import net.latexdrones.block.DronePodBlock;
import net.latexdrones.block.DroneTerminalBlock;
import net.latexdrones.block.FacingBlock;
import net.latexdrones.block.GasVentBlock;
import net.latexdrones.block.GooBlock;
import net.latexdrones.block.HiveCoreBlock;
import net.latexdrones.block.InfectiousBlock;
import net.latexdrones.block.LatexPlantBlock;
import net.latexdrones.block.ModStairBlock;
import net.latexdrones.block.PuddleBlock;
import net.minecraft.core.Registry;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.world.item.BlockItem;
import net.minecraft.world.item.Item;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.GlassBlock;
import net.minecraft.world.level.block.RotatedPillarBlock;
import net.minecraft.world.level.block.SlabBlock;
import net.minecraft.world.level.block.SoundType;
import net.minecraft.world.level.block.state.BlockBehaviour;
import net.minecraft.world.level.material.MapColor;
import net.minecraft.world.level.material.PushReaction;

/**
 * All /*COUNT*/ blocks of the mod.
 * GENERATED by tools/gen_assets.py from tools/content.py + tools/ModBlocks.java.template.
 */
public final class ModBlocks {
    private ModBlocks() {
    }

    public static final List<Block> ALL = new ArrayList<>();
    public static final List<Item> ITEMS = new ArrayList<>();
    /** Blocks that need the cutout render layer (client side). */
    public static final List<Block> CUTOUT = new ArrayList<>();
    /** Blocks that need the translucent render layer (client side). */
    public static final List<Block> TRANSLUCENT = new ArrayList<>();

    private static BlockBehaviour.Properties latex(MapColor color) {
        return BlockBehaviour.Properties.of().mapColor(color).strength(0.8F).sound(SoundType.SLIME_BLOCK).speedFactor(0.85F);
    }

    private static BlockBehaviour.Properties see(BlockBehaviour.Properties props) {
        return props.isSuffocating((state, level, pos) -> false)
                .isViewBlocking((state, level, pos) -> false)
                .isRedstoneConductor((state, level, pos) -> false);
    }

    private static BlockBehaviour.Properties goo(MapColor color) {
        return see(BlockBehaviour.Properties.of().mapColor(color).strength(0.6F).sound(SoundType.HONEY_BLOCK)
                .speedFactor(0.4F).jumpFactor(0.5F).noOcclusion());
    }

    private static BlockBehaviour.Properties puddle(MapColor color) {
        return BlockBehaviour.Properties.of().mapColor(color).strength(0.2F).sound(SoundType.SLIME_BLOCK).speedFactor(0.7F);
    }

    private static BlockBehaviour.Properties earth(MapColor color, SoundType sound, float hardness) {
        return BlockBehaviour.Properties.of().mapColor(color).strength(hardness).sound(sound);
    }

    private static BlockBehaviour.Properties rock(MapColor color, float hardness) {
        return BlockBehaviour.Properties.of().mapColor(color).strength(hardness, 6.0F).sound(SoundType.STONE)
                .requiresCorrectToolForDrops();
    }

    private static BlockBehaviour.Properties wood(MapColor color) {
        return BlockBehaviour.Properties.of().mapColor(color).strength(2.0F, 3.0F).sound(SoundType.WOOD);
    }

    private static BlockBehaviour.Properties lab() {
        return BlockBehaviour.Properties.of().mapColor(MapColor.QUARTZ).strength(3.0F, 9.0F).sound(SoundType.STONE)
                .requiresCorrectToolForDrops();
    }

    private static BlockBehaviour.Properties metal() {
        return BlockBehaviour.Properties.of().mapColor(MapColor.METAL).strength(4.0F, 9.0F).sound(SoundType.METAL)
                .requiresCorrectToolForDrops();
    }

    private static BlockBehaviour.Properties glass(float hardness, float resistance) {
        return see(BlockBehaviour.Properties.of().mapColor(MapColor.NONE).strength(hardness, resistance)
                .sound(SoundType.GLASS).noOcclusion());
    }

    private static BlockBehaviour.Properties plant(MapColor color) {
        return BlockBehaviour.Properties.of().mapColor(color).noCollission().instabreak().sound(SoundType.GRASS)
                .pushReaction(PushReaction.DESTROY);
    }

    private static BlockBehaviour.Properties crystal(MapColor color) {
        return BlockBehaviour.Properties.of().mapColor(color).noCollission().strength(0.5F).sound(SoundType.AMETHYST_CLUSTER)
                .lightLevel(state -> 9).pushReaction(PushReaction.DESTROY);
    }

    /** layer: 0 = solid, 1 = cutout, 2 = translucent. */
    private static Block register(String name, Block block, int layer) {
        Registry.register(BuiltInRegistries.BLOCK, LatexDrones.id(name), block);
        Item item = Registry.register(BuiltInRegistries.ITEM, LatexDrones.id(name), new BlockItem(block, new Item.Properties()));
        ALL.add(block);
        ITEMS.add(item);
        if (layer == 1) {
            CUTOUT.add(block);
        } else if (layer == 2) {
            TRANSLUCENT.add(block);
        }
        return block;
    }

/*BLOCKS*/

    /** Forces the static initialiser to run. */
    public static void init() {
    }
}
